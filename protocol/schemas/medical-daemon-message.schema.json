{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/medical-daemon/daemon-message.schema.json",
  "title": "Medical Data Daemon Message",
  "description": "Schema for medical data management daemon messages including patient data, biosensor, biofeedback, and medical protocol messages (FHIR/HL7)",
  "type": "object",
  "required": [
    "protocol",
    "request_id",
    "source",
    "command",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "type": "string",
      "description": "Protocol version used by the daemon contract.",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "request_id": {
      "type": "string",
      "description": "Unique request identifier generated by the client.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "source": {
      "type": "string",
      "description": "Client family sending the message.",
      "anyOf": [
        {
          "enum": [
            "cli",
            "tui",
            "gui",
            "webui",
            "frontend",
            "backend",
            "api",
            "medical",
            "test",
            "rpi-sensor",
            "rpi-effector",
            "rpi-forward",
            "biosensor-device",
            "biofeedback-device",
            "patient-record",
            "fhir-server",
            "hl7-system"
          ]
        },
        {
          "type": "string",
          "pattern": "^(rpi-[A-Za-z0-9_.:-]+|remote-[A-Za-z0-9_.:-]+|device-[A-Za-z0-9_.:-]+)$"
        }
      ]
    },
    "command": {
      "type": "string",
      "description": "Command name handled by the daemon.",
      "enum": [
        "ping",
        "status",
        "frontend.event",
        "backend.job",
        "shutdown",
        "patient.data",
        "biosensor.data",
        "biofeedback.data",
        "medical.message",
        "medical.fhir",
        "medical.hl7",
        "swarm.sensor",
        "swarm.effector",
        "swarm.forward"
      ]
    },
    "payload": {
      "type": ["object", "null"],
      "description": "Command-specific business payload. Keep frontend logic thin; validate in daemon/backend modules.",
      "oneOf": [
        {
          "$ref": "#/$defs/PatientDataPayload"
        },
        {
          "$ref": "#/$defs/BiosensorDataPayload"
        },
        {
          "$ref": "#/$defs/BiofeedbackDataPayload"
        },
        {
          "$ref": "#/$defs/MedicalFHIRPayload"
        },
        {
          "$ref": "#/$defs/MedicalHL7Payload"
        },
        {
          "$ref": "#/$defs/SwarmSensorPayload"
        },
        {
          "$ref": "#/$defs/SwarmEffectorPayload"
        },
        {
          "description": "Empty payload for control commands (ping, status, shutdown, backend.job, swarm.forward)",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      ]
    },
    "meta": {
      "type": "object",
      "description": "Optional transport, auth, trace and compatibility metadata.",
      "additionalProperties": true,
      "properties": {
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "patient_id": {
          "type": "string",
          "description": "Optional patient identifier for HIPAA/GDPR compliance tracking"
        },
        "encryption": {
          "type": "boolean",
          "description": "Indicates if payload is encrypted"
        }
      }
    }
  },
  "$defs": {
    "PatientDataPayload": {
      "type": "object",
      "description": "Podmiotowe i przedmiotowe dane pacjenta",
      "required": ["patient_id", "data_type"],
      "properties": {
        "patient_id": {
          "type": "string",
          "description": "Unikalny identyfikator pacjenta"
        },
        "data_type": {
          "type": "string",
          "enum": ["podmiotowe", "przedmiotowe"],
          "description": "Typ danych: podmiotowe (wywiad) lub przedmiotowe (badanie)"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "provider": {
          "type": "string",
          "description": "Źródło danych (lekarz, pielęgniarka, system)"
        },
        "data": {
          "type": "object",
          "description": "Struktura danych medycznych zależna od typu",
          "additionalProperties": true
        }
      }
    },
    "BiosensorDataPayload": {
      "type": "object",
      "description": "Dane z czujników biosensor (biopotencjały, parametry fizjologiczne)",
      "required": ["sensor_id", "sensor_type", "value", "timestamp"],
      "properties": {
        "sensor_id": {
          "type": "string",
          "description": "Unikalny identyfikator czujnika"
        },
        "sensor_type": {
          "type": "string",
          "enum": ["ecg", "eeg", "emg", "eog", "ppg", "spo2", "temperature", "humidity", "pressure", "accelerometer", "gyroscope"],
          "description": "Typ czujnika biosensor"
        },
        "value": {
          "type": "number",
          "description": "Wartość pomiaru"
        },
        "unit": {
          "type": "string",
          "description": "Jednostka pomiaru (mV, Hz, °C, %, mmHg, itp.)"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "sample_rate": {
          "type": "number",
          "description": "Częstotliwość próbkowania w Hz"
        },
        "quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Wskaźnik jakości sygnału (0-100%)"
        }
      }
    },
    "BiofeedbackDataPayload": {
      "type": "object",
      "description": "Dane z czujników biofeedback (trening autonomii, HRV, GSR, temperatura)",
      "required": ["sensor_id", "feedback_type", "value", "timestamp"],
      "properties": {
        "sensor_id": {
          "type": "string",
          "description": "Unikalny identyfikator urządzenia biofeedback"
        },
        "feedback_type": {
          "type": "string",
          "enum": ["hrv", "gsr", "temperature", "respiration", "alpha_waves", "beta_waves", "theta_waves", "delta_waves"],
          "description": "Typ treningu biofeedback"
        },
        "value": {
          "type": "number",
          "description": "Wartość parametru biofeedback"
        },
        "unit": {
          "type": "string",
          "description": "Jednostka (ms, μS, °C, breaths/min, μV)"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "session_id": {
          "type": "string",
          "description": "Identyfikator sesji treningowej"
        },
        "target_value": {
          "type": "number",
          "description": "Docelowa wartość dla treningu"
        },
        "progress_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Postęp w sesji treningowej (%)"
        }
      }
    },
    "MedicalFHIRPayload": {
      "type": "object",
      "description": "Wiadomość medyczna w formacie FHIR (Fast Healthcare Interoperability Resources)",
      "required": ["resourceType"],
      "properties": {
        "resourceType": {
          "type": "string",
          "enum": ["Bundle", "Patient", "Observation", "Condition", "Procedure", "MedicationRequest", "DiagnosticReport", "ImagingStudy", "MessageHeader"],
          "description": "Typ zasobu FHIR"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Typ Bundle dla wiadomości"
        },
        "entry": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "MedicalHL7Payload": {
      "type": "object",
      "description": "Wiadomość medyczna w formacie HL7v2",
      "required": ["message_type", "raw_message"],
      "properties": {
        "message_type": {
          "type": "string",
          "enum": ["ADT^A01", "ADT^A04", "ADT^A08", "ORM^O01", "ORU^R01", "SIU^S12"],
          "description": "Typ wiadomości HL7v2"
        },
        "raw_message": {
          "type": "string",
          "description": "Surowa wiadomość HL7 zaczynająca się od MSH"
        },
        "parsed_segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "description": "Opcjonalnie: parsowane segmenty HL7"
        }
      }
    },
    "SwarmSensorPayload": {
      "type": "object",
      "description": "Dane sensora z sieci Raspberry Pi swarm",
      "required": ["node", "role", "sensor", "value", "timestamp_utc"],
      "properties": {
        "node": {
          "type": "string",
          "description": "Nazwa węzła RPi"
        },
        "role": {
          "type": "string",
          "enum": ["main", "worker"]
        },
        "sensor": {
          "type": "string",
          "description": "Typ sensora"
        },
        "value": {
          "type": "string",
          "description": "Wartość z sensora"
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "SwarmEffectorPayload": {
      "type": "object",
      "description": "Polecenie dla efektora w sieci Raspberry Pi swarm",
      "required": ["node", "role", "effector", "state", "timestamp_utc"],
      "properties": {
        "node": {
          "type": "string",
          "description": "Nazwa węzła RPi"
        },
        "role": {
          "type": "string",
          "enum": ["main", "worker"]
        },
        "effector": {
          "type": "string",
          "description": "Nazwa efektora"
        },
        "state": {
          "type": "string",
          "description": "Stan do ustawienia"
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
