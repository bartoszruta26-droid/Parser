# Medical System Daemon Configuration
# Kopiuj ten plik jako daemon.conf i edytuj według potrzeb

# Interwał odpytywania sensorów (w sekundach)
POLL_INTERVAL=5

# Maksymalna liczba obsługiwanych sensorów
MAX_SENSORS=32

# Rozmiar bufora danych
BUFFER_SIZE=1000

# Poziom logowania: DEBUG, INFO, WARN, ERROR
LOG_LEVEL="INFO"

# Ścieżki (domyślne względem /workspace/medical-system)
# PID_FILE="/workspace/medical-system/run/medical-daemon.pid"
# LOG_FILE="/workspace/medical-system/logs/medical-daemon.log"
# SOCKET_FILE="/workspace/medical-system/run/medical-daemon.sock"

# Lista znanych adresów IP sensorów Ethernet
# KNOWN_ETH_IPS=("192.168.1.100" "192.168.1.101" "192.168.1.102")

# Domyślny baudrate dla sensorów USB
USB_BAUDRATE=9600

# Timeout dla połączeń HTTP do sensorów Ethernet (sekundy)
HTTP_TIMEOUT=2

# Timeout dla połączeń TCP do sensorów Ethernet (sekundy)
TCP_TIMEOUT=2

# Port HTTP dla sensorów Ethernet (domyślnie 80)
ETH_HTTP_PORT=80

# Port TCP dla sensorów Ethernet (alternatywa dla HTTP)
ETH_TCP_PORT=8080

# Czy automatycznie wykrywać sensory USB przy starcie
AUTO_DETECT_USB=true

# Czy automatycznie wykrywać sensory Ethernet przy starcie
AUTO_DETECT_ETH=true

# Czy wysyłać dane do backendu (np. FHIR, HL7)
BACKEND_ENABLED=false

# Adres backendu (jeśli BACKEND_ENABLED=true)
# BACKEND_URL="http://localhost:8080/api/v1/data"

# Klucz API dla backendu (opcjonalny)
# BACKEND_API_KEY=""
