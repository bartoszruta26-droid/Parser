# Example configuration for the medical data management daemon.
# Copy this file to /etc/medical-daemon/daemon.conf or set DAEMON_CONFIG
# to another path before starting the service.

APP_NAME="medical-data-daemon"
RUN_DIR="/tmp/medical-daemon"
LOG_DIR="/tmp/medical-daemon/log"
COMMAND_FIFO="${RUN_DIR}/commands.fifo"
RESPONSE_DIR="${RUN_DIR}/responses"
STATE_FILE="${RUN_DIR}/state.env"
DAEMON_LOG="${LOG_DIR}/daemon.log"
PROTOCOL_VERSION="1"
REQUEST_TIMEOUT_SECONDS="10"
TUI_REFRESH_SECONDS="2"
GUI_DIALOG_TOOL="auto"
WEBUI_TITLE="Medical Data Daemon WebUI"
PROTOCOL_FORMAT="json"
PROTOCOL_SCHEMA_DIR="/opt/medical-daemon/protocol/schemas"
PROTOCOL_EXAMPLES_DIR="/opt/medical-daemon/protocol/examples"
MEDICAL_PROTOCOL_PROFILE="fhir"
PROTOCOL_TRANSPORT="fifo"
PROTOCOL_RUNTIME="bash-linux"

# Queue files for different data types
PATIENT_DATA_QUEUE="${RUN_DIR}/patient-data.jsonl"
SENSOR_BIOSENSOR_QUEUE="${RUN_DIR}/biosensor-events.jsonl"
SENSOR_BIOFEEDBACK_QUEUE="${RUN_DIR}/biofeedback-events.jsonl"
MEDICAL_FHIR_QUEUE="${RUN_DIR}/fhir-messages.jsonl"
MEDICAL_HL7_QUEUE="${RUN_DIR}/hl7-messages.jsonl"
SWARM_QUEUE="${RUN_DIR}/swarm-events.jsonl"

# Raspberry Pi swarm topology.
# Copy this file on every RPi and change RPI_NODE_NAME/RPI_NODE_ROLE to match
# the physical device. Exactly one node should keep RPI_NODE_ROLE="main";
# the remaining nodes should use RPI_NODE_ROLE="worker". Keep swarm disabled
# until the helper/transport is configured on every participating RPi.
RPI_SWARM_ENABLED="false"
RPI_NODE_NAME="rpi-main"
RPI_NODE_ROLE="main"
RPI_MAIN_DAEMON_NAME="rpi-main"
RPI_MAIN_DAEMON_HOST="192.168.1.10"
RPI_MAIN_DAEMON_PORT="8701"
RPI_MAIN_DAEMON_ENDPOINT="tcp://${RPI_MAIN_DAEMON_HOST}:${RPI_MAIN_DAEMON_PORT}"
RPI_LOCAL_DAEMON_BIND_HOST="0.0.0.0"
RPI_LOCAL_DAEMON_BIND_PORT="8701"
RPI_ENABLE_TCP_FORWARD="false"

# Inventory of Raspberry Pi nodes in the swarm. Keep addresses static through
# DHCP reservations or static network configuration so worker daemons always
# know where to reach the main daemon.
RPI_SWARM_NODES="rpi-main=192.168.1.10:8701,rpi-worker-01=192.168.1.11:8701,rpi-worker-02=192.168.1.12:8701,rpi-worker-03=192.168.1.13:8701"
RPI_WORKER_DAEMON_ENDPOINTS="rpi-worker-01=tcp://192.168.1.11:8701,rpi-worker-02=tcp://192.168.1.12:8701,rpi-worker-03=tcp://192.168.1.13:8701"

# Optional hardware maps for the RPi swarm helper. A source/target can be a
# readable file or an executable script. Effector file targets are overwritten
# with the requested state, while executable targets receive the state as $1.
RPI_SENSOR_SOURCES="temperature=/tmp/medical-daemon/sensors/temperature.value,humidity=/tmp/medical-daemon/sensors/humidity.value"
RPI_EFFECTOR_TARGETS="relay=/tmp/medical-daemon/effectors/relay.state,fan=/tmp/medical-daemon/effectors/fan.state"

# Medical data specific settings
PATIENT_DATA_ENCRYPTION="true"
PATIENT_DATA_RETENTION_DAYS="365"
BIOSENSOR_SAMPLE_RATE_HZ="100"
BIOFEEDBACK_SAMPLE_RATE_HZ="50"
FHIR_SERVER_ENDPOINT="http://localhost:8080/fhir"
HL7_MLP_LISTENER_PORT="2575"
